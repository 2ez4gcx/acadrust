<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <OutputPath>../../../target/explode-oracle/managed/</OutputPath>
    <IntermediateOutputPath>../../../target/explode-oracle/managed-obj/</IntermediateOutputPath>
    <AutoCADPath Condition="'$(AutoCADPath)' == ''">C:/Program Files/Autodesk/AutoCAD 2027</AutoCADPath>
    <DotNetRuntimePath Condition="'$(DotNetRuntimePath)' == ''">C:/Program Files/dotnet/shared/Microsoft.NETCore.App/10.0.9</DotNetRuntimePath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCADPath)/accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCADPath)/acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(DotNetRuntimePath)/*.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
