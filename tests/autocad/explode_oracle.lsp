  (ae:run "TEXT" '(lambda () (entmakex '((0 . "TEXT") (10 0.0 0.0 0.0) (40 . 2.5) (1 . "Example")))))
  (ae:run "RAY" '(lambda () (entmakex '((0 . "RAY") (100 . "AcDbEntity") (100 . "AcDbRay") (10 0.0 0.0 0.0) (11 1.0 0.0 0.0)))))
  (ae:run "XLINE" '(lambda () (entmakex '((0 . "XLINE") (100 . "AcDbEntity") (100 . "AcDbXline") (10 0.0 0.0 0.0) (11 1.0 0.0 0.0)))))
  (ae:run "LWPOLYLINE" 'ae:poly)
