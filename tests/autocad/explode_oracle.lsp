(defun ae:emit (value)
  (write-line value ae:out)
  (princ (strcat "\nAE|" value))
)

(defun ae:point (x y z) (list x y z))

(defun ae:line ()
  (entmakex '((0 . "LINE") (10 0.0 0.0 0.0) (11 10.0 0.0 0.0)))
)

(defun ae:circle ()
  (entmakex '((0 . "CIRCLE") (10 0.0 0.0 0.0) (40 . 2.0)))
)

(defun ae:poly ()
  (entmakex '((0 . "LWPOLYLINE") (100 . "AcDbEntity")
    (100 . "AcDbPolyline") (90 . 4) (70 . 1)
    (10 0.0 0.0) (10 10.0 0.0) (10 10.0 10.0) (10 0.0 10.0)))
)

(defun ae:hatch (pattern)
  (entmakex (append
    '((0 . "HATCH") (100 . "AcDbEntity") (100 . "AcDbHatch")
      (10 0.0 0.0 0.0) (210 0.0 0.0 1.0))
    (list (cons 2 pattern) (cons 70 (if (= pattern "SOLID") 1 0)))
    '((71 . 0) (91 . 1) (92 . 2) (72 . 0) (73 . 1) (93 . 4)
      (10 0.0 0.0) (10 10.0 0.0) (10 10.0 10.0) (10 0.0 10.0)
      (97 . 0) (75 . 0) (76 . 1))
    (if (= pattern "SOLID")
      '((98 . 0))
      '((52 . 0.0) (41 . 1.0) (77 . 0) (78 . 1) (53 . 45.0)
        (43 . 0.0) (44 . 0.0) (45 . -2.1213203435596424)
        (46 . 2.1213203435596424) (79 . 0) (98 . 0))))
  )
)

(defun ae:block (name flags /)
  (entmake (list '(0 . "BLOCK") (cons 2 name) (cons 70 flags) '(10 0.0 0.0 0.0)))
  (entmake '((0 . "CIRCLE") (10 0.0 0.0 0.0) (40 . 2.0)))
  (entmake '((0 . "LINE") (10 0.0 0.0 0.0) (11 10.0 0.0 0.0)))
  (entmake '((0 . "ENDBLK")))
)

(defun ae:polyface (indices / point)
  (entmake '((0 . "POLYLINE") (66 . 1) (10 0.0 0.0 0.0) (70 . 64) (71 . 4) (72 . 1)))
  (foreach point '((0.0 0.0 0.0) (10.0 0.0 0.0) (10.0 10.0 0.0) (0.0 10.0 0.0))
    (entmake (list '(0 . "VERTEX") '(70 . 192) (cons 10 point))))
  (entmake (append '((0 . "VERTEX") (70 . 128) (10 0.0 0.0 0.0))
    (mapcar 'cons '(71 72 73 74) indices)))
  (entmake '((0 . "SEQEND")))
)

(defun ae:polygonmesh (closed / i j)
  (entmake (list '(0 . "POLYLINE") '(66 . 1) '(10 0.0 0.0 0.0)
    (cons 70 (+ 16 closed)) '(71 . 3) '(72 . 3)))
  (setq i 0)
  (repeat 3
    (setq j 0)
    (repeat 3
      (entmake (list '(0 . "VERTEX") '(70 . 64) (cons 10 (list (* 10.0 i) (* 10.0 j) 0.0))))
      (setq j (1+ j)))
    (setq i (1+ i)))
  (entmake '((0 . "SEQEND")))
)

(defun ae:run (label creator / marker source item data status count)
  (entmakex '((0 . "POINT") (10 9999.0 9999.0 9999.0)))
  (setq marker (entlast))
  (setq status (vl-catch-all-apply creator '()))
  (if (vl-catch-all-error-p status)
    (ae:emit (strcat label "|CREATE_ERROR|" (vl-catch-all-error-message status)))
    (progn
      (setq source (entlast))
      (if (or (null source) (= source marker))
        (ae:emit (strcat label "|CREATE_FAILED"))
        (progn
          (ae:emit (strcat label "|SOURCE|" (vl-prin1-to-string (entget source))))
          (ae:emit (strcat label "|SOURCE_TYPE|" (cdr (assoc 0 (entget source)))))
          (setq status (vl-catch-all-apply '(lambda () (command-s "_.explode" source "")) '()))
          (if (vl-catch-all-error-p status)
            (ae:emit (strcat label "|EXPLODE_ERROR|" (vl-catch-all-error-message status))))
          (ae:emit (strcat label "|SOURCE_SURVIVES|" (if (entget source) "YES" "NO")))
          (setq item (entnext marker) count 0)
          (while item
            (setq data (entget item))
            (if (and data (not (equal item source)))
              (progn
                (setq count (1+ count))
                (ae:emit (strcat label "|RESULT_TYPE|" (cdr (assoc 0 data))))
                (ae:emit (strcat label "|RESULT|" (vl-prin1-to-string data)))))
            (setq item (entnext item)))
          (ae:emit (strcat label "|RESULT_COUNT|" (itoa count)))
        )
      )
    )
  )
  (princ)
)

(defun ae:main (/ saved variable)
  (setq ae:root (getenv "ACADRUST_ORACLE_ROOT"))
  (setq ae:out (open (strcat ae:root "/target/explode-oracle/runtime.txt") "w"))
