  (ae:run "MLINE" '(lambda () (command "_.mline" "_non" '(0.0 0.0 0.0) "_non" '(10.0 0.0 0.0) "")))
  (ae:run "LEADER_STRAIGHT" '(lambda () (entmakex '((0 . "LEADER") (100 . "AcDbEntity") (100 . "AcDbLeader") (3 . "Standard") (71 . 1) (72 . 0) (73 . 3) (74 . 0) (75 . 0) (40 . 2.5) (41 . 5.0) (76 . 3) (10 0.0 0.0 0.0) (10 10.0 10.0 0.0) (10 15.0 10.0 0.0) (210 0.0 0.0 1.0)))))
  (ae:run "LEADER_SPLINE" '(lambda () (entmakex '((0 . "LEADER") (100 . "AcDbEntity") (100 . "AcDbLeader") (3 . "Standard") (71 . 1) (72 . 1) (73 . 3) (74 . 0) (75 . 0) (40 . 2.5) (41 . 5.0) (76 . 3) (10 0.0 0.0 0.0) (10 10.0 10.0 0.0) (10 15.0 10.0 0.0) (210 0.0 0.0 1.0)))))
  (ae:run "DIM_LINEAR" '(lambda () (command "_.dimlinear" "_non" '(0.0 0.0 0.0) "_non" '(10.0 0.0 0.0) "_non" '(0.0 5.0 0.0))))
